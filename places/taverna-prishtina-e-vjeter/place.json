  "review_snippets": [
    {
      "text": "Ushqimi ma i mir n’Sheher",
      "author": "Termo",
      "rating": 5
    },
    {
      "text": "Ushqimi perfekt\nSherbimi perfekt\n10/10",
      "author": "Arlion",
      "rating": 5
    },
    {
      "text": "Skara më e mirë në Prishtinë!",
      "author": "Malsor",
      "rating": 5
    },
    {
      "text": "Ushqimi ishte i tmerrshëm, shërbimi shumë i dobët. Pa dyshim restoranti më i keq ku kam ngrënë ndonjëherë. Mendoj se shumë nga komentet pozitive online nuk janë reale.",
      "author": "Shkodran",
      "rating": 1
    },
    {
      "text": "Ushqimi ke katastrofal aspak shije, porcioni shum i keq i dobt me qmimin restauranti ma i keq qe kom honger n’prishtin osht ky qe doni veq me dhon pare shkoni a per me honger sdin mebo katastrof.",
      "author": "Engjell",
      "rating": 1
    }
