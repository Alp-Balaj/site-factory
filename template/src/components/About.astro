---
import { site, t } from '../lib/config';
const paras = site.about.text.split(/\n\n+/);
const { rating, reviews_count } = site.business;
---
<section class="about">
  <div class="wrap grid">
    <div>
      <h2>{site.about.title}</h2>
      {paras.map(p => <p>{p}</p>)}
    </div>
    {rating && reviews_count ? (
      <aside>
        <span class="big">{rating.toFixed(1)}</span>
        <span>nga {reviews_count} vlerësime në Google</span>
        {site.business.mapsUrl && <a href={site.business.mapsUrl} target="_blank" rel="noopener">Lexoji vlerësimet</a>}
      </aside>
    ) : null}
  </div>
</section>
<style>
  .about{background:var(--muted)}
  .grid{display:grid;gap:3rem;grid-template-columns:1fr;align-items:start}
  @media (min-width:800px){.grid{grid-template-columns:2fr 1fr}}
  p{max-width:36rem;margin-bottom:1rem}
  aside{display:grid;gap:.25rem;padding:1.5rem;border-left:4px solid var(--accent)}
  .big{font-family:var(--font-display);font-size:4rem;line-height:1;color:var(--primary)}
</style>
