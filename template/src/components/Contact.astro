---
import { site, t, waLink } from '../lib/config';
const b = site.business;
const credit = { label: site.credit?.label || 'Alp', url: site.credit?.url || 'https://REPLACE-ME.com' };
const mapSrc = b.lat ? `https://www.google.com/maps?q=${b.lat},${b.lng}&z=16&output=embed` : b.address ? `https://www.google.com/maps?q=${encodeURIComponent(b.address)}&output=embed` : '';
---
<section id="contact" class="contact">
  <div class="wrap grid">
    <div class="details">
      <h2>{t.contact}</h2>
      <address>
        {b.address && <p>{b.address}</p>}
        {b.phone && <p><a href={`tel:${b.phone}`}>{b.phone}</a></p>}
        {b.email && <p><a href={`mailto:${b.email}`}>{b.email}</a></p>}
        {(b.instagram || b.facebook) && (
          <p class="social">
            {b.instagram && <a href={b.instagram} target="_blank" rel="noopener">Instagram</a>}
            {b.facebook && <a href={b.facebook} target="_blank" rel="noopener">Facebook</a>}
          </p>
        )}
      </address>
      <a class="btn primary" href={waLink()}>{t.cta}</a>
    </div>
    {mapSrc && <figure class="patch map"><iframe src={mapSrc} title={t.map} loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe></figure>}
  </div>
</section>
<footer class="foot">
  <div class="wrap line">
    <span>© {new Date().getFullYear()} {b.name}</span>
    <span>{t.credit} <a href={credit.url}>{credit.label}</a></span>
  </div>
</footer>
<style>
  .contact { background: var(--primary); color: var(--on-primary); padding-block: 0; }
  .grid { display: grid; gap: 2rem; grid-template-columns: 1fr; padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .details { display: grid; gap: 1.25rem; align-content: start; justify-items: start; }
  address { font-style: normal; display: grid; gap: .4rem; font-size: 1.1rem; }
  .social { display: flex; gap: 1.25rem; }
  .map { aspect-ratio: 4 / 3; --patch: var(--muted); }
  .map iframe { width: 100%; height: 100%; border: 0; display: block; }
  .foot .line { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1.5rem; padding-block: 1.25rem 1.75rem; font-size: .9rem; color: var(--ink-2); }
  @media (min-width: 800px) { .grid { grid-template-columns: 1fr 1fr; align-items: start; } }
</style>
