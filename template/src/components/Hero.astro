---
import { site, t, waLink } from '../lib/config';
const { business, hero } = site;
---
<header class="hero">
  <nav class="wrap nav">
    <span class="brand">{business.name}</span>
    <a class="btn ghost" href={`tel:${business.phone}`}>{business.phone}</a>
  </nav>
  <div class="wrap stage">
    <div class="photo">
      {hero.image ? <img src={hero.image} alt="" width="1600" height="1000" fetchpriority="high" /> : <div class="ph"></div>}
    </div>
    <h1>{business.name}</h1>
  </div>
  <div class="wrap under">
    <p class="headline">{hero.headline}</p>
    <p class="lede">{hero.sub}</p>
    <div class="ctas">
      <a class="btn accent" href={waLink(`Përshëndetje ${business.name}, `)}>{t.cta}</a>
      <a class="btn ghost" href="#items">{t.items}</a>
    </div>
  </div>
</header>
<style>
  .nav{display:flex;justify-content:space-between;align-items:center;padding-block:1.1rem}
  .brand{font-family:var(--font-display);font-size:1.25rem;font-weight:500}
  .stage{position:relative;padding-top:1rem}
  .photo{border-radius:1.25rem;overflow:hidden;aspect-ratio:16/10;background:var(--muted)}
  .photo img{width:100%;height:100%;object-fit:cover}
  .ph{width:100%;height:100%;background:linear-gradient(135deg,var(--muted),var(--primary))}
  h1{font-size:clamp(3rem,11vw,9rem);color:var(--primary);margin-top:-.45em;padding-inline:.15em;position:relative;word-break:break-word}
  h1::after{content:"";position:absolute;inset:.55em 0 0 0;z-index:-1;background:var(--bg)}
  .under{padding-block:1.25rem 3rem;max-width:44rem;margin-inline:auto}
  .headline{font-family:var(--font-display);font-size:clamp(1.5rem,3vw,2.25rem);line-height:1.15;margin-bottom:.75rem}
  .ctas{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.5rem}
  @media (max-width:640px){.nav .btn{display:none}}
</style>
