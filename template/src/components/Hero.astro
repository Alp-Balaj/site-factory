---
import { site, t, waLink, compactHours } from '../lib/config';
const { business, hero } = site;
const hours = compactHours(site.hours);
const fringe = hours.length <= 3 ? hours : hours.slice(0, 1); // long irregular weeks: first line here, full list in Hours
const longest = Math.max(...business.name.split(/\s+/).map(w => w.length), 4); // the name fills the phone width: size from its longest word
---
<header class="hero">
  <div class="band"></div>
  <nav class="wrap nav">
    <a class="brand" href="#top">{business.name}</a>
    {business.phone && <a class="phone" href={`tel:${business.phone}`}>{business.phone}</a>}
  </nav>
  <div class="wrap field" id="top">
    <div class="words weave" style={`--chars:${longest}`}>
      <h1>{business.name}</h1>
      <p class="headline">{hero.headline}</p>
      <div class="ctas">
        <a class="btn primary" href={waLink(`Përshëndetje ${business.name}, `)}>{t.cta}</a>
        <a class="btn" href="#items">{t.items}</a>
      </div>
    </div>
    <figure class={`patch photo weave late${hero.image ? '' : ' motif'}`}>
      {hero.image && <img src={hero.image} alt="" width="1600" height="1200" fetchpriority="high" decoding="async" />}
    </figure>
    {fringe.length ? (
      <dl class="fringe">
        {fringe.map(h => <div><dt>{h.day}</dt><dd>{h.time}</dd></div>)}
        {fringe.length < hours.length && <a href="#hours">{t.allHours}</a>}
      </dl>
    ) : null}
  </div>
  <div class="band"></div>
</header>
<style>
  .hero { background: var(--primary); color: var(--on-primary); --patch: var(--muted); }
  .nav { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-block: 1rem; min-height: 4rem; }
  .brand { font-family: var(--font-display); font-weight: 700; font-size: 1rem; text-decoration: none; letter-spacing: -.01em; }
  .phone { font-weight: 600; text-decoration: none; }
  @media (max-width: 639px) { .nav { display: none; } .field { padding-top: 1.5rem; } }

  .field { display: grid; gap: 1.5rem; padding-block: .5rem 2rem; }
  .words { display: grid; gap: 1rem; align-content: start; }
  .headline { font-size: clamp(1.15rem, 2.2vw, 1.4rem); line-height: 1.35; max-width: 34ch; color: var(--on-primary); }
  .ctas { display: none; gap: .75rem; flex-wrap: wrap; margin-top: .5rem; }

  .photo { aspect-ratio: 4 / 3; overflow: hidden; }
  /* no photo yet: a large stepped diamond woven in the accent, a smaller one in the ground colour inside it */
  .motif { position: relative; }
  .motif::before, .motif::after { content: ""; position: absolute; inset: 0; margin: auto; -webkit-mask: var(--motif) center / contain no-repeat; mask: var(--motif) center / contain no-repeat; }
  .motif::before { width: 62%; height: 62%; background: var(--accent); }
  .motif::after { width: 28%; height: 28%; background: var(--primary); }

  .fringe { display: grid; gap: .35rem .75rem; grid-template-columns: 1fr; font-size: 1rem; }
  .fringe div { display: flex; justify-content: space-between; gap: 1rem; padding-block: .35rem; }
  .fringe div + div { background: repeating-linear-gradient(90deg, color-mix(in srgb, var(--on-primary) 45%, transparent) 0 var(--stitch), transparent var(--stitch) calc(var(--stitch) * 2)) top / 100% 2px no-repeat; }
  .fringe dt { text-transform: capitalize; }
  .fringe dd { font-weight: 600; white-space: nowrap; }
  .fringe a { font-size: .95rem; }

  @media (min-width: 800px) {
    .ctas { display: flex; }
    .field { grid-template-columns: 1.1fr 1fr; grid-template-rows: auto 1fr; column-gap: 3rem; row-gap: 1.5rem; padding-block: 2rem 3.5rem; }
    .words { grid-column: 1; grid-row: 1; padding-top: 1rem; }
    .photo { grid-column: 2; grid-row: 1 / span 2; aspect-ratio: 1; max-height: 30rem; }
    .fringe { grid-column: 1; grid-row: 2; align-self: start; max-width: 28rem; }
  }
</style>
