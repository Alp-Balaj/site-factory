---
import { site, t } from '../lib/config';
---
{site.hours?.length ? (
<section id="hours" class="wrap">
  <h2>{t.hours}</h2>
  <dl class="patch list">
    {site.hours.map(h => <div><dt>{h.day}</dt><dd>{h.time}</dd></div>)}
  </dl>
</section>) : null}
<style>
  .list { max-width: 30rem; padding: .5rem 1.25rem; --patch: var(--muted); color: var(--on-muted); --rule: color-mix(in srgb, currentColor 45%, transparent); }
  .list div { display: flex; justify-content: space-between; gap: 1rem; padding-block: .7rem; }
  .list div + div { background: repeating-linear-gradient(90deg, var(--rule) 0 var(--stitch), transparent var(--stitch) calc(var(--stitch) * 2)) top / 100% 2px no-repeat; }
  dt { text-transform: capitalize; }
  dd { font-weight: 600; white-space: nowrap; }
</style>
