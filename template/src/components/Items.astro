---
import { site, t, vertical } from '../lib/config';
const groups = vertical.itemGroups.filter(g => site.items.some(i => i.group === g)).map(g => ({ g, items: site.items.filter(i => i.group === g) }));
const leftovers = site.items.filter(i => !vertical.itemGroups.includes(i.group));
if (leftovers.length) groups.push({ g: t.otherGroup, items: leftovers });
const biggest = Math.max(...groups.map(x => x.items.length));
---
<section id="items" class="wrap">
  <h2>{t.items}</h2>
  <p class="lede">{t.itemsIntro}</p>
  <div class="patches">
    {groups.map(({ g, items }, n) => (
      <div class={`patch group${items.length === biggest ? ' wide' : ''}`} style={items.length === biggest ? '--patch:var(--primary);color:var(--on-primary)' : '--patch:var(--muted);color:var(--on-muted)'}>
        <h3>{g}</h3>
        <ul>
          {items.map(i => (
            <li class="row">
              <span class="stitch"></span>
              <span class="name">{i.name}{i.desc && <small>{i.desc}</small>}</span>
              {i.price && <span class="price">{i.price}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
<style>
  .patches { display: grid; gap: 1rem; margin-top: 2rem; grid-template-columns: 1fr; }
  .group { padding: 1.25rem 1.25rem 1.5rem; --rule: color-mix(in srgb, currentColor 45%, transparent); }
  h3 { margin-bottom: .35rem; }
  ul { list-style: none; padding: 0; }
  .row { position: relative; display: grid; grid-template-columns: 1fr auto; column-gap: 1rem; align-items: baseline; padding-block: .8rem .75rem; }
  .row .stitch { position: absolute; inset: 0 0 auto 0; transition: background-color 160ms ease; }
  .name { font-weight: 600; display: grid; gap: .1rem; }
  small { font-size: .9rem; font-weight: 400; max-width: 30ch; }
  .price { font-weight: 600; min-width: 6.5ch; text-align: right; white-space: nowrap; }
  @media (hover: hover) and (pointer: fine) { .row:hover { --rule: var(--accent); } }
  /* each row's stitch rule is sewn in as it enters the viewport; already drawn under reduced motion or without scroll-driven animation */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .row .stitch { animation: stitch-in linear both; animation-timeline: view(); animation-range: entry 0% entry 40%; }
    }
  }
  @keyframes stitch-in { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }
  @media (min-width: 800px) {
    /* two columns; the biggest group spans both and sets its rows in two columns; dense packing so no cell stays empty,
       and when the count leaves an orphan the last group spans both as well */
    .patches { grid-template-columns: repeat(2, 1fr); grid-auto-flow: dense; }
    .wide, .group:last-child:nth-child(even) { grid-column: span 2; }
    .wide ul, .group:last-child:nth-child(even) ul { columns: 2; column-gap: 2.5rem; }
    .row { break-inside: avoid; }
  }
</style>
