---
import { site, t, layout, itemGroups } from '../lib/config';
const known = itemGroups.filter(g => site.items.some(i => i.group === g)).map(g => ({ g, items: site.items.filter(i => i.group === g) }));
const leftovers = site.items.filter(i => !itemGroups.includes(i.group));
const groups = leftovers.length ? [...known, { g: t.otherGroup, items: leftovers }] : known;
const biggest = Math.max(...groups.map(x => x.items.length));
// Three shapes for the same items. list: group patches with rows, the largest on primary. cards: every item its own
// muted card in a grid. board: one dense price board on primary with dotted leaders. The filler tag is the same in all three.
const menu = layout.menu;
---
<section id="items" class={`wrap menu ${menu}`}>
  <h2>{t.items}</h2>
  <p class="lede">{t.itemsIntro}</p>

  {menu === 'list' && (
    <div class="patches">
      {groups.map(({ g, items }) => (
        <div class={`patch group${items.length === biggest ? ' wide' : ''}`} style={items.length === biggest ? '--patch:var(--primary);color:var(--on-primary)' : '--patch:var(--muted);color:var(--on-muted)'}>
          <h3>{g}</h3>
          <ul>
            {items.map(i => (
              <li class="row">
                <span class="name">
                  <span class="title">{i.name}{i.source === 'filler' && <span class="tag">{t.sample}</span>}</span>
                  {i.desc && <small>{i.desc}</small>}
                </span>
                {i.price && <span class="price">{i.price}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}

  {menu === 'cards' && (
    <div class="sets">
      {groups.map(({ g, items }) => (
        <div class="set">
          <h3>{g}</h3>
          <ul class="cards">
            {items.map(i => (
              <li class="patch card">
                <span class="title">{i.name}{i.source === 'filler' && <span class="tag">{t.sample}</span>}</span>
                {i.desc && <small>{i.desc}</small>}
                {i.price && <span class="price">{i.price}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}

  {menu === 'board' && (
    <div class="patch board">
      {groups.map(({ g, items }) => (
        <div class="set">
          <h3>{g}</h3>
          <ul>
            {items.map(i => (
              <li class="line">
                <span class="title">{i.name}{i.source === 'filler' && <span class="tag">{t.sample}</span>}</span>
                <span class="leader" aria-hidden="true"></span>
                {i.price && <span class="price">{i.price}</span>}
                {i.desc && <small>{i.desc}</small>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}
</section>
<style>
  ul { list-style: none; padding: 0; }
  h3 { margin-bottom: .35rem; }
  .title { font-weight: 600; display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: .15rem .5rem; }
  small { font-size: .9rem; font-weight: 400; max-width: 30ch; }
  .price { font-weight: 600; min-width: 6.5ch; text-align: right; white-space: nowrap; }

  /* list: one menu row is name and description left, price in a fixed right column; a hairline above each row in the surface's own colour */
  .patches { display: grid; gap: 1rem; margin-top: var(--space-block); grid-template-columns: 1fr; }
  .group { padding: 1.25rem 1.25rem 1.5rem; }
  .row { display: grid; grid-template-columns: 1fr auto; column-gap: 1rem; align-items: baseline; padding-block: .8rem .75rem; border-top: 1px solid color-mix(in srgb, currentColor 30%, transparent); transition: border-color 160ms ease; }
  .name { display: grid; gap: .1rem; }
  @media (hover: hover) and (pointer: fine) { .row:hover { border-top-color: var(--accent); } }

  /* cards: every item its own muted patch, two across on a phone, as many as fit on a desktop; the price closes the card */
  .sets { display: grid; gap: var(--space-block); margin-top: var(--space-block); }
  .set h3 { margin-bottom: .75rem; }
  .cards { display: grid; gap: .75rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .card { --patch: var(--muted); color: var(--on-muted); padding: 1rem 1rem 1.1rem; display: grid; gap: .3rem; align-content: start; }
  .card .title { display: flex; }
  .card .price { margin-top: .6rem; min-width: 0; text-align: left; font-weight: 700; }

  /* board: one dense price board on the primary surface, dotted leaders from name to price, two columns on a desktop */
  .board { --patch: var(--primary); color: var(--on-primary); margin-top: var(--space-block); padding: 1.5rem clamp(1.25rem, 4vw, 2.5rem) 1.75rem; }
  .board .set { break-inside: avoid; }
  .board .set + .set { margin-top: 1.5rem; }
  .board h3 { margin-bottom: .5rem; }
  .line { display: grid; grid-template-columns: fit-content(100%) minmax(1.5rem, 1fr) auto; column-gap: .6rem; align-items: baseline; padding-block: .3rem; }
  .line .title { min-width: 0; }
  .leader { align-self: end; height: 0; margin-bottom: .45em; border-bottom: 2px dotted color-mix(in srgb, currentColor 45%, transparent); }
  .line .price { min-width: 0; }
  .line small { grid-column: 1 / -1; color: var(--ink-2); max-width: 40ch; margin-top: -.1rem; }

  @media (min-width: 800px) {
    /* list: two columns; the biggest group spans both and sets its rows in two columns; dense packing so no cell stays empty,
       and when the count leaves an orphan the last group spans both as well */
    .patches { grid-template-columns: repeat(2, 1fr); grid-auto-flow: dense; }
    .wide, .group:last-child:nth-child(even) { grid-column: span 2; }
    .wide ul, .group:last-child:nth-child(even) ul { columns: 2; column-gap: 2.5rem; }
    .row { break-inside: avoid; }

    .cards { grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: 1rem; }
    .card { padding: 1.1rem 1.2rem 1.25rem; }

    .board { columns: 2; column-gap: 3.5rem; padding-block: 2rem 2.25rem; }
    .board .set:first-child { margin-top: 0; }
  }
</style>
