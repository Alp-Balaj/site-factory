---
import { site, t, waLink } from '../lib/config';
---
<div class="bar">
  {site.business.phone && <a class="btn call" href={`tel:${site.business.phone}`}>{t.call}</a>}
  {site.business.whatsapp && <a class="btn primary" href={waLink()}>{t.cta}</a>}
</div>
<style>
  /* the locked anchor: call and WhatsApp, same proportion at every width, phones only; edge-to-edge so it keeps no corner */
  .bar { position: fixed; inset: auto 0 0 0; z-index: 10; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; background: var(--bg); color: var(--ink); border-top: 1px solid var(--line); padding-bottom: env(safe-area-inset-bottom); }
  .bar .btn { min-height: 3.75rem; border: 0; border-radius: 0; font-size: 1rem; padding-inline: .75rem; }
  .bar .btn + .btn { border-left: 1px solid var(--line); }
  @media (min-width: 800px) { .bar { display: none; } }
</style>
