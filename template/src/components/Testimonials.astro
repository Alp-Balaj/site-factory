---
// What Google reviewers said, first names only (config.testimonials, written by the generator). Nothing when empty.
import { t, testimonials } from '../lib/config';
---
{testimonials.length ? (
<section id="testimonials" class="wrap said">
  <h2>{t.testimonials}</h2>
  <ul class="quotes">
    {testimonials.map(q => (
      <li>
        <blockquote><p>{q.text.trim()}</p></blockquote>
        {q.name?.trim() && <cite>{q.name.trim()}</cite>}
      </li>
    ))}
  </ul>
</section>) : null}
<style>
  /* quotes sit on the ground under a hairline each, side by side when there is room; no cards, no quote glyphs */
  .quotes { list-style: none; padding: 0; margin-top: var(--space-block); display: grid; gap: 1.5rem 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  li { display: grid; gap: .75rem; align-content: start; padding-top: 1rem; border-top: 1px solid color-mix(in srgb, currentColor 30%, transparent); }
  blockquote { margin: 0; }
  blockquote p { font-size: 1.15rem; line-height: 1.45; max-width: 36ch; text-wrap: pretty; }
  cite { font-style: normal; font-weight: 600; color: var(--ink-2); }
</style>
