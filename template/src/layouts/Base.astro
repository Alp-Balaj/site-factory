---
import '../styles/global.css';
import { site, theme, luminance, contrast, fontWeights } from '../lib/config';
const { business, seo } = site;
// Google Fonts css2: one family per entry with exactly the static weights it carries (see fontWeights).
// The display weight the theme asks for is added to the display face when the family has it.
const families = [...new Set([theme.display, theme.body])];
const fonts = (await Promise.all(families.map(async f => {
  const w = await fontWeights(f);
  const list = [...new Set([...w, ...(f === theme.display && theme.displayWeight && w.includes(theme.displayWeight) ? [theme.displayWeight] : [])])].sort((a, b) => a - b);
  return `${f.replace(/ /g, '+')}:wght@${list.join(';')}`;
}))).join('&family=');
const scheme = luminance(theme.bg) < 0.4 ? 'dark' : 'light';
// Text on each coloured surface: whichever of ink/bg contrasts more with it (WCAG ratio), so any token set stays readable.
const on = (surface: string) => (contrast(theme.ink, surface) >= contrast(theme.bg, surface) ? theme.ink : theme.bg);
const onColors = `--on-primary:${on(theme.primary)};--on-accent:${on(theme.accent)};--on-muted:${on(theme.muted)}`;
// Edge language: none, a hairline in the surface's own text colour, or a solid ink frame.
const frame = { none: '0px', line: '1px', thick: '3px' }[theme.frame ?? 'line'] ?? '1px';
const frameColor = theme.frame === 'thick' ? 'var(--ink)' : 'color-mix(in srgb, currentColor 22%, transparent)';
const ld = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', name: business.name, telephone: business.phone,
  address: { '@type': 'PostalAddress', streetAddress: business.address, addressLocality: business.city, addressCountry: 'XK' },
  ...(business.lat ? { geo: { '@type': 'GeoCoordinates', latitude: business.lat, longitude: business.lng } } : {}),
};
---
<!doctype html>
<html lang="sq">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
  <meta property="og:title" content={seo.title} />
  <meta property="og:description" content={seo.description} />
  {site.hero.image && <meta property="og:image" content={site.hero.image} />}
  <meta name="theme-color" content={theme.primary} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=${fonts}&display=swap`} />
  <style set:html={`:root{--bg:${theme.bg};--ink:${theme.ink};--primary:${theme.primary};--accent:${theme.accent};--muted:${theme.muted};--font-display:"${theme.display}";--font-body:"${theme.body}";--display-weight:${theme.displayWeight ?? 700};--radius:${theme.radius ?? '0px'};--frame-w:${frame};--frame-c:${frameColor};${onColors};color-scheme:${scheme}}`}></style>
  <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>
</head>
<body>
  <slot />
</body>
</html>
